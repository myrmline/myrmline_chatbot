# ============================================================
# Copiez ce fichier en ".env" et adaptez les valeurs
# ============================================================

# Serveur
PORT=5000
NODE_ENV=development

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=skincare
DB_PASSWORD=skincare_pw
DB_NAME=skincare_chat

# Authentification JWT (backoffice)
JWT_SECRET=change_this_super_secret_key_in_production
JWT_EXPIRES_IN=8h

# CORS : origines autorisées (séparées par une virgule)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Compte administrateur créé par le seed initial
SEED_ADMIN_EMAIL=admin@skincare.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=Super Admin
